VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Telegram bot (api/), set these in Vercel only, not in .env.local
# KD_BOT_TOKEN=<telegram-bot-token>
# KD_CHAT_ID=<kd-schemes-group-id>
# KD_ALLOWED=<telegram-user-id>,<telegram-user-id>
# TG_SECRET=<random-string, also the Telegram webhook secret>
# GH_DISPATCH_TOKEN=<fine-grained token, this repo, Actions read+write>
# GH_REPO=MehulD31/MarginMart
# KD_BOT_KEY=<bot_key from public.bot_secret>
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon-public-key>
# GEMINI_KEY=<gemini-api-key, reads one-line /sale messages>
